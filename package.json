{
  "name": "zhengtao-picks",
  "version": "1.0.0",
  "description": "正涛精选 — Obsidian reader for multi-agent, agent-memory and LLM agent RSS picks",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "gen:feeds": "node scripts/build-feeds.mjs",
    "feeds:check": "node scripts/live-check.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "npm test && npm run check:api && npm run gen:feeds && npm run build",
    "check:api": "node scripts/check-api.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "obsidian": "^1.13.1"
  }
}
